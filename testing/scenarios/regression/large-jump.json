{
  "protocolVersion": 1,
  "id": "large-jump",
  "driver": "gpio",
  "memory": { "heapSize": 32768 },
  "patterns": [{ "type": 0, "steps": [
    { "type": "HOLD", "state": "ON", "durationMs": 100 },
    { "type": "HOLD", "state": "OFF", "durationMs": 100 },
    { "type": "HOLD", "state": "ON", "durationMs": 100 },
    { "type": "STOP", "durationMs": 0 }
  ] }],
  "operations": [
    { "op": "start", "type": 0 }, { "op": "update" },
    { "op": "advance", "ms": 250 }, { "op": "update" },
    { "op": "advance", "ms": 50 }, { "op": "update" }
  ],
  "assertions": [
    { "type": "state", "at": 250, "field": "pinR", "equals": 1 },
    { "type": "state", "at": 300, "field": "activeCount", "equals": 0 },
    { "type": "reference" }
  ],
  "budgets": { "maxOperations": 6, "timeoutMs": 3000 }
}
