{
  "protocolVersion": 1,
  "id": "priority-background",
  "driver": "gpio",
  "memory": { "heapSize": 32768 },
  "patterns": [
    { "type": 10, "steps": [
      { "type": "HOLD", "state": "ON", "durationMs": 50 },
      { "type": "HOLD", "state": "OFF", "durationMs": 50 },
      { "type": "LOOP", "durationMs": 0 }
    ] },
    { "type": 0, "steps": [
      { "type": "HOLD", "state": "OFF", "durationMs": 150 },
      { "type": "STOP", "durationMs": 0 }
    ] }
  ],
  "operations": [
    { "op": "start", "type": 10 }, { "op": "update" },
    { "op": "start", "type": 0 }, { "op": "update" },
    { "op": "advance", "ms": 50 }, { "op": "update" },
    { "op": "advance", "ms": 100 }, { "op": "update" },
    { "op": "advance", "ms": 50 }, { "op": "update" }
  ],
  "assertions": [
    { "type": "state", "at": 50, "field": "pinR", "equals": 0 },
    { "type": "state", "at": 150, "field": "selectedType", "equals": 10 },
    { "type": "state", "at": 200, "field": "pinR", "equals": 1 },
    { "type": "memory", "phase": "afterDestroy", "field": "liveBlocks", "equals": 0 },
    { "type": "reference" }
  ],
  "budgets": { "maxOperations": 10, "timeoutMs": 3000 }
}
